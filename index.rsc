d:["$","aside",null,{"className":"observationCard","children":[["$","span",null,{"children":"THE 3-DAY WORD AUDIT"}],["$","ol",null,{"children":[["$","li",null,{"children":"Notice recurring words and complaints."}],["$","li",null,{"children":"Write the thought beneath each phrase."}],["$","li",null,{"children":"Replace one limiting phrase with a truthful, constructive alternative."}],["$","li",null,{"children":"Support the new thought with one practical action."}]]}]]}]
e:["$","section",null,{"className":"systemOverview section","id":"about-system","children":[["$","div",null,{"className":"systemHero","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"TIMELESS WISDOM FOR MODERN LIFE"}],["$","h2",null,{"children":"The Master Key System"}]]}],["$","div",null,{"className":"systemLead","children":[["$","p",null,{"children":[["$","em",null,{"children":"The Master Key System"}]," is a powerful 24-week journey into the extraordinary potential of your own mind."]}],["$","p",null,{"children":"Written by Charles F. Haanel more than a century ago, its principles remain deeply relevant today. It teaches you how to understand your thoughts, strengthen your mental faculties and bring your conscious and subconscious minds into greater harmony."}],["$","a",null,{"className":"haanelLink","href":"https://en.mrmasterkey.com/charles-f-haanel-biography/","target":"_blank","rel":"noopener noreferrer","children":[["$","span",null,{"children":"MEET THE MIND BEHIND THE SYSTEM"}],"Learn about Charles F. Haanel ",["$","b",null,{"children":"↗"}]]}],["$","p",null,{"children":["$","strong",null,{"children":"This is not simply a book to read. It is a system to study, practise and apply."}]}]]}]]}],["$","div",null,{"className":"systemStatement","children":[["$","p",null,{"className":"eyebrow","children":"WHAT MAKES IT SO POWERFUL?"}],["$","blockquote",null,{"children":"Most people try to change their circumstances without first changing the thinking that helped create them."}],["$","p",null,{"children":"The Master Key System begins within. It combines disciplined action with stillness, logic with intuition, concentration with relaxation, and knowledge with practical application. The objective is not to escape life. It is to live with greater purpose, awareness and personal responsibility."}]]}],["$","div",null,{"className":"benefitGrid","children":[["$","div","Observe and direct your thoughts",{"children":[["$","span",null,{"children":"01"}],["$","p",null,{"children":"Observe and direct your thoughts"}]]}],["$","div","Strengthen focus and concentration",{"children":[["$","span",null,{"children":"02"}],["$","p",null,{"children":"Strengthen focus and concentration"}]]}],["$","div","Create clearer mental pictures of your goals",{"children":[["$","span",null,{"children":"03"}],["$","p",null,{"children":"Create clearer mental pictures of your goals"}]]}],["$","div","Replace limiting habits with constructive ones",{"children":[["$","span",null,{"children":"04"}],["$","p",null,{"children":"Replace limiting habits with constructive ones"}]]}],["$","div","Respond calmly instead of reacting emotionally",{"children":[["$","span",null,{"children":"05"}],["$","p",null,{"children":"Respond calmly instead of reacting emotionally"}]]}],["$","div","Make decisions with greater confidence",{"children":[["$","span",null,{"children":"06"}],["$","p",null,{"children":"Make decisions with greater confidence"}]]}],["$","div","Bring thoughts, words and actions into alignment",{"children":[["$","span",null,{"children":"07"}],["$","p",null,{"children":"Bring thoughts, words and actions into alignment"}]]}],["$","div","Turn meaningful intentions into consistent action",{"children":[["$","span",null,{"children":"08"}],["$","p",null,{"children":"Turn meaningful intentions into consistent action"}]]}]]}],["$","div",null,{"className":"systemColumns","children":[["$","article",null,{"children":[["$","p",null,{"className":"eyebrow","children":"WHAT THE PROGRAMME INCLUDES"}],["$","h3",null,{"children":"Knowledge becomes powerful when you apply it."}],["$","p",null,{"children":"Every chapter gives you the teaching, a practical mental exercise, questions and answers, and guidance for applying the lesson in everyday life. The chapters engage the logical mind, but the exercises create the practical transformation."}],["$","p",null,{"children":"Each exercise builds on the previous one, developing your ability to relax, concentrate, visualise, contemplate and consciously direct your attention."}],["$","p",null,{"className":"systemQuote","children":["“Knowledge does not apply itself.” ","$L1b"]}]]}],"$L1c"]}],"$L1d","$L1e","$L1f"]}]
