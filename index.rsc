28:["$","details","2",{"children":[["$","summary",null,{"children":[["$","span",null,{"className":"week","children":["WEEK ","02"]}],["$","strong",null,{"children":"One Method of Finding the Truth"}],["$","b",null,{"children":"＋"}]]}],["$","div",null,{"className":"chapterBody","children":[["$","h3",null,{"children":"Introduction"}],["$","p",null,{"children":"This week distinguishes the reasoning conscious mind from the receptive subconscious mind and explains how they are meant to cooperate."}],false,["$","h3",null,{"children":"Content"}],["$","p",null,{"children":"The conscious mind discriminates, reasons and chooses. The subconscious stores impressions, controls habitual processes and acts on the dominant ideas repeatedly given to it."}],["$","h3",null,{"children":"Exercise"}],["$","p",null,{"children":"Use the same place and posture as Week 1. Be perfectly still and gently inhibit thought. Each time care, worry or fear enters, release it and return to mental quiet."}],["$","$L20",null,{"week":2,"title":"One Method of Finding the Truth","introduction":"This week distinguishes the reasoning conscious mind from the receptive subconscious mind and explains how they are meant to cooperate.","content":"The conscious mind discriminates, reasons and chooses. The subconscious stores impressions, controls habitual processes and acts on the dominant ideas repeatedly given to it.","exercise":"Use the same place and posture as Week 1. Be perfectly still and gently inhibit thought. Each time care, worry or fear enters, release it and return to mental quiet.","masteryOutcome":"Distinguish the conscious and subconscious modes of mind and deliberately choose a constructive idea to impress through repetition."}],["$","div",null,{"className":"weeklyQA","children":[["$","h3",null,{"children":"Questions & Answers"}],["$","dl",null,{"children":[["$","div","2-0-What are the two modes of mental activity?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"c