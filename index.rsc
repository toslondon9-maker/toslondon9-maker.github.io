a:["$","p",null,{"children":"A simple first step is to observe your language without judgement. Repeated words can reveal repeated thoughts; repeated thoughts can become habits. Use the free reflection below, then explore an independent beginner’s guide for further context."}]
b:["$","div",null,{"className":"actions","children":[["$","a",null,{"className":"primary","href":"#free-guide","children":"Get the free reflection guide →"}],["$","a",null,{"className":"secondary","href":"https://en.mrmasterkey.com/beginners-guide/","target":"_blank","rel":"noopener noreferrer","children":"Read Mr Master Key’s guide ↗"}],["$","a",null,{"className":"secondary","href":"https://en.mrmasterkey.com/shop/","target":"_blank","rel":"noopener noreferrer","children":"Gifts to Purchase ↗"}]]}]
