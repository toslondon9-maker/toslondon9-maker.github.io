10:["$","section",null,{"className":"section method","id":"method","children":[["$","div",null,{"className":"sectionIntro","children":[["$","p",null,{"className":"eyebrow","children":"THE METHOD"}],["$","h2",null,{"children":"Four stages. One powerful inner shift."}],["$","p",null,{"children":"This is not passive motivation. Each stage develops a specific mental faculty through weekly teaching, reflection and deliberate daily practice."}]]}],["$","div",null,{"className":"stages","children":[["$","article","01",{"children":[["$","div",null,{"className":"stageTop","children":[["$","span",null,{"children":"01"}],["$","small",null,{"children":"Weeks 1–4"}]]}],["$","h3",null,{"children":"Foundation"}],["$","p",null,{"children":"Understand the inner world, establish a daily practice and take conscious responsibility for the patterns shaping your results."}]]}],["$","article","02",{"children":[["$","div",null,{"className":"stageTop","children":[["$","span",null,{"children":"02"}],["$","small",null,{"children":"Weeks 5–9"}]]}],["$","h3",null,{"children":"Visualisation"}],["$","p",null,{"children":"Turn vague wishes into clear mental pictures, connect them to purpose and rehearse the person you are becoming."}]]}],["$","article","03",{"children":[["$","div",null,{"className":"stageTop","children":[["$","span",null,{"children":"03"}],["$","small",null,{"children":"Weeks 10–18"}]]}],["$","h3",null,{"children":"Concentration"}],["$","p",null,{"children":"Train sustained attention, strengthen discipline and learn to direct your energy toward one meaningful outcome at a time."}]]}],["$","article","04",{"children":[["$","div",null,{"className":"stageTop","children":[["$","span",null,{"children":"04"}],["$","small",null,{"children":"Weeks 19–24"}]]}],["$","h3",null,{"children":"Contemplation & Mastery"}],["$","p",null,{"children":"Deepen your understanding, integrate the principles into daily life and build an independent practice that lasts."}]]}]]}]]}]
11:["$","section",null,{"className":"story section","id":"story","children":[["$","div",null,{"className":"storyMark","children":["$","img",null,{"src":"/images/tariq-ts-logo.png?v=20260725-final","alt":"Tariq Saddique gold TS monogram"}]}],["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"WHY I CREATED THIS"}],["$","h2",null,{"children":"From achievement on the outside to mastery on the inside."}],["$","p",null,{"children":["My name is Tariq Saddique. For years, I have worked in sales, partnerships and leadership—helping people create opportunities, build confidence and turn potential into measurable results. Yet one question kept returning: ",["$","strong",null,{"children":"what allows a person to stay focused, disciplined and purposeful when life becomes demanding?"}]]}],["$","p",null,{"children":["That search led me deeper into meditation, visualisation, concentration and the principles of ",["$","em",null,{"children":"The Master Key System"}],". I discovered that change does not begin with another burst of motivation. It begins by training the mind, aligning thought with purpose and repeating the right actions until they become part of who we are."]}],["$","p",null,{"children":"I created this guided journey for people who are ready to do the inner work—not to escape real life, but to meet it with greater clarity, calm and personal power. I teach as an independent practitioner and committed student, combining timeless ideas with practical accountability for modern life."}],["$","div",null,{"className":"storySoundtrack","children":[["$","div",null,{"children":[["$","small",null,{"children":"MY STORY SOUNDTRACK"}],["$","strong",null,{"children":"Listen as you read my journey"}]]}],["$","audio",null,{"controls":true,"loop":true,"preload":"metadata","children":[["$","source",null,{"src":"/audio/my-story-theme.m4a","type":"audio/mp4"}],"Your browser does not support the audio player."]}]]}],["$","div",null,{"className":"signature","children":["Tariq ",["$","span",null,{"children":"— your guide and accountability partner"}]]}]]}]]}]
