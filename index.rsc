70:["$","div","14-8-What is the result of a change of thought?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"What is the result of a change of thought?"]}],["$","dd",null,{"children":"A change in conditions."}]]}]
71:["$","div","14-9-What is the result of a harmonious mental attitude?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"What is the result of a harmonious mental attitude?"]}],["$","dd",null,{"children":"Harmonious conditions in life."}]]}]
72:["$","div","15-7-How can we overcome fear, lack, limitation, poverty and discord?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":8}],"How can we overcome fear, lack, limitation, poverty and discord?"]}],["$","dd",null,{"children":"By substituting principle for error."}]]}]
73:["$","div","15-8-How may we recognize principle?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"How may we recognize principle?"]}],["$","dd",null,{"children":"By realizing that Truth destroys error just as light destroys darkness."}]]}]
74:["$","div","15-9-What is the value of Insight?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"What is the value of Insight?"]}],["$","dd",null,{"children":"It enables us to understand the value of applying the knowledge we gain."}]]}]
75:["$","span",null,{"className":"qaNumber","children":8}]
76:["$","dd",null,{"children":"Destructive thinking."}]
77:["$","div","16-8-What is the source of all good?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"What is the source of all good?"]}],["$","dd",null,{"children":"Scientific correct thinking."}]]}]
78:["$","div","16-9-What is scientific thinking?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"What is scientific thinking?"]}],["$","dd",null,{"children":"Recognition of the creative nature of spiritual energy and our ability to control it."}]]}]
79:["$","dd",null,{"children":"By developing perception, wisdom, intuition and sagacity."}]
7a:["$","div","17-8-Why is intuition superior to reason?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"Why is intuition superior to reason?"]}],["$","dd",null,{"children":"It does not depend on experience or memory and can reveal solutions by unknown methods."}]]}]
7b:["$","div","17-9-What is the result of pursuing the symbol of reality?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"What is the result of pursuing the symbol of reality?"]}],["$","dd",null,{"children":"Symbols can turn to ashes unless we possess the spiritual reality of which they are the outward form."}]]}]
7c:["$","dd",null,{"children":"By the law of growth."}]
7d:["$","div","18-7-Upon what condition does growth depend?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":8}],"Upon what condition does growth depend?"]}],["$","dd",null,{"children":"Upon reciprocal action; it is possible to receive only as we give."}]]}]
7e:["$","div","18-8-What is it that we give?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"What is it that we give?"]}],["$","dd",null,{"children":"Thought."}]]}]
7f:["$","div","18-9-What do we receive?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"What do we receive?"]}],["$","dd",null,{"children":"Thought, differentiated in form by what we think."}]]}]
80:["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":8}],"Upon what does mental action depend?"]}]
81:["$","dd",null,{"children":"Upon polarity—action and reaction between the individual and the Universal."}]
82:["$","div","19-8-Does creative energy originate in the individual or Universal?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"Does creative energy originate in the individual or Universal?"]}],["$","dd",null,{"children":"In the Universal, which can manifest only through the individual."}]]}]
83:["$","div","19-9-Why is the individual necessary?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"Why is the individual necessary?"]}],["$","dd",null,{"children":"The Universal is static and requires energy to start it in motion; food is converted into energy that enables the individual to think."}]]}]
84:["$","div","20-8-What is inspiration?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"What is inspiration?"]}],["$","dd",null,{"children":"The art of realizing the omnipresence of Omniscience."}]]}]
85:["$","div","20-9-Upon what do the conditions with which we meet depend?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"Upon what do the conditions with which we meet depend?"]}],["$","dd",null,{"children":"Upon the quality of our thought; what we do depends on what we are, and what we are depends on what we think."}]]}]
86:["$","dd",null,{"children":"He thinks big thoughts and holds ideas large enough to counteract petty obstacles."}]
87:["$","div","21-7-How do experiences come to us?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":8}],"How do experiences come to us?"]}],["$","dd",null,{"children":"Through the law of attraction."}]]}]
88:["$","div","21-8-How is this law brought into operation?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"How is this law brought into operation?"]}],["$","dd",null,{"children":"By our predominant mental attitude."}]]}]
89:["$","div","21-9-What is the issue between the old regime and the new?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"What is the issue between the old regime and the new?"]}],["$","dd",null,{"children":"The old clings to fatalism; the new recognizes the divinity of the individual and democracy of humanity."}]]}]
8a:["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":8}],"What is the result of this system of thought?"]}]
8b:["$","dd",null,{"children":"Haanel says it presents a demonstrable truth capable of satisfying the reasoning faculty."}]
8c:["$","div","22-8-Is this system applicable to other forms of supply?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"Is this system applicable to other forms of supply?"]}],["$","dd",null,{"children":"It will meet every human requirement or necessity."}]]}]
8d:["$","div","22-9-Is this system scientific or religious?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"Is this system scientific or religious?"]}],["$","dd",null,{"children":"Both. Haanel describes true science and true religion as twin sisters."}]]}]
8e:["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":8}],"What is the effect of concentrating upon gain?"]}]
8f:["$","dd",null,{"children":"More gain."}]
90:["$","div","23-8-Is this principle used in the business world?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"Is this principle used in the business world?"]}],["$","dd",null,{"children":"It is the only principle ever used; unconscious use does not alter the situation."}]]}]
91:["$","div","23-9-What is the practical application?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"What is the practical application?"]}],["$","dd",null,{"children":"Success is an effect, not a cause; to secure it, find the cause, idea or thought by which it is created."}]]}]
92:["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":7}],"What is the nature of the Universal Mind?"]}]
93:["$","dd",null,{"children":"It is spiritual and creative, and seeks to express itself in form."}]
94:["$","div","24-7-How may we act on the Universal Mind?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":8}],"How may we act on the Universal Mind?"]}],["$","dd",null,{"children":"Our ability to think is our ability to act on it and bring it into manifestation for ourselves or others."}]]}]
95:["$","div","24-8-What is meant by thinking?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":9}],"What is meant by thinking?"]}],["$","dd",null,{"children":"Clear, decisive, calm, deliberate, sustained thought with a definite end in view."}]]}]
96:["$","div","24-9-What will be the result?",{"className":"qaPair","children":[["$","dt",null,{"children":[["$","span",null,{"className":"qaNumber","children":10}],"What will be the result?"]}],["$","dd",null,{"children":"Haanel says we come to recognize the Universal Mind as the indwelling source through which the work is done."}]]}]
