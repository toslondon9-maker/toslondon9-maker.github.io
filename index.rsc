1c:["$","article",null,{"children":[["$","p",null,{"className":"eyebrow","children":"THE MASTER KEY"}],["$","h3",null,{"children":"Your ability to direct the world within."}],["$","p",null,{"children":"Your thoughts influence your attention. Your attention influences your choices. Your repeated choices shape your habits—and your habits play a major role in the direction of your life."}],["$","p",null,{"children":"As your thinking becomes clearer, you move from confusion to clarity, fear to understanding, reaction to conscious choice, distraction to concentration, and intention to disciplined action."}]]}]
1d:["$","div",null,{"className":"systemFaq","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"STRAIGHT ANSWERS"}],["$","h2",null,{"children":"The questions that matter before you begin."}],["$","p",null,{"children":"You do not need to accept every idea without question. Study the principles, test the exercises and observe what changes in your own thinking and behaviour."}]]}],["$","div",null,{"className":"faqList","children":[["$","details",null,{"children":[["$","summary",null,{"children":["Does it really work?",["$","b",null,{"children":"＋"}]]}],["$","p",null,{"children":"The system cannot do the work for you. You must do the work. It provides principles, exercises and a progressive path; your results depend on consistency, honesty, patience and application. This is mental training—not passive motivation."}]]}],["$","details",null,{"children":[["$","summary",null,{"children":["When will I notice a difference?",["$","b",null,{"children":"＋"}]]}],["$","p",null,{"children":"Change can begin as soon as you start paying closer attention—to your language, repeated thoughts, emotional reactions, habits and overlooked opportunities. Lasting transformation develops through steady repetition, not overnight perfection."}]]}],["$","details",null,{"children":[["$","summary",null,{"children":["How much time will I need?",["$","b",null,{"children":"＋"}]]}],["$","p",null,{"children":"Allow approximately 60–90 minutes a day for reading, reflection and practical exercises. A focused daily practice is more powerful than studying intensely for a few days and then stopping."}]]}],["$","details",null,{"children":[["$","summary",null,{"children":["What if I ignore the exercises?",["$","b",null,{"children":"＋"}]]}],["$","p",null,{"children":"You may understand the words intellectually, but you will miss the heart of the system. Reading tells you what is possible; practice develops stillness, control, relaxation, visualisation, concentration and contemplation."}]]}],["$","details",null,{"children":[["$","summary",null,{"children":["Is it spiritual or scientific?",["$","b",null,{"children":"＋"}]]}],["$","p",null,{"children":"Haanel explores psychology, consciousness, cause and effect, mental habits, Universal Mind and Natural Law. You do not need to follow a particular religion or culture to benefit from the practical exercises. Think, question, test and observe."}]]}]]}]]}]
