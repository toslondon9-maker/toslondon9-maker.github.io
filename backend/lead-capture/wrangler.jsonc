{
  "name": "unleash-your-power-leads",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-04",
  "vars": { "ALLOWED_ORIGINS": "https://toslondon9-maker.github.io" },
  // Intentionally no `ratelimits` binding: add the owner-created binding only during manual Cloudflare setup.
  // The Worker fails closed while LEAD_RATE_LIMITER is absent.
  "env": {
    "development": { "vars": { "ALLOWED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787" } }
  }
}
